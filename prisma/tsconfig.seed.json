{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "isolatedModules": false,
    "noEmit": false
  },
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  },
  "include": [
    "./seed.ts",
    "./seed-data/**/*.ts",
    "../src/constants/haven-agreement-content.ts"
  ]
}
