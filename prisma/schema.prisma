// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// =======================================================
// GENERATOR & DATASOURCE
// =======================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =======================================================
// CORE MASTER ENTITIES
// =======================================================

// Location remains part of the reusable core and is still used by the legacy
// theatre module, coupons, and other existing systems. For Haven Retreat phase 1,
// Venue is introduced alongside Location instead of replacing it destructively.
model Location {
  id        String  @id @default(cuid())
  name      String  @unique // Miami, Florida
  city      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // Relations
  packages EventPackage[]
  coupons  Coupon[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================================================
// VENUE EVENT MODULE (PHASE 1 ADDITIVE)
// =======================================================

enum VenueBusinessType {
  PRIVATE_THEATRE
  EVENT_VENUE
  OTHER
}

model Venue {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  businessType       VenueBusinessType @default(EVENT_VENUE)
  description        String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  country            String?
  phone              String?
  email              String?
  images             String[]
  maxGuests          Int?
  cleaningFee        Int?
  setupBufferMinutes Int               @default(0)
  isActive           Boolean           @default(true)

  // Relations
  packages EventPackage[]
  addons   EventAddon[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessType, isActive])
  @@index([city, state, country])
}

model EventPackage {
  id                      String @id @default(cuid())
  venueId                 String
  name                    String
  slug                    String @unique
  shortDescription        String?
  guestLimit              Int
  eventDurationHours      Int
  complimentarySetupHours Int    @default(0)
  hourlyRate              Int    @default(0)
  rentalAmount            Int
  decorationAmount        Int    @default(0)
  cleaningAmount          Int    @default(0)
  subtotalAmount          Int
  savingsAmount           Int    @default(0)
  finalAmount             Int
  decorationAddonPrice    Int     @default(375)
  decorationDefault       Boolean @default(true)
  locationId              String?
  isPopular               Boolean @default(false)
  sortOrder               Int     @default(0)
  isActive                Boolean @default(true)

  // Relations
  venue         Venue            @relation(fields: [venueId], references: [id])
  location      Location?        @relation(fields: [locationId], references: [id])
  features      PackageFeature[]
  bookings      Booking[]
  addons        EventAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
  @@index([venueId, isActive, sortOrder])
  @@index([locationId, isActive, sortOrder])
}

enum PackageFeatureGroup {
  INCLUDED
  DECORATION
  CLEANING
  PRICE_BREAKDOWN
}

model PackageFeature {
  id        String              @id @default(cuid())
  packageId String
  group     PackageFeatureGroup
  label     String
  value     String?
  icon      String?
  sortOrder Int                 @default(0)

  // Relations
  eventPackage EventPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId, group, sortOrder])
}

enum EventAddonCategory {
  DECORATION
  FURNITURE
  FOOD_BEVERAGE
  ENTERTAINMENT
  SERVICE
  OTHER
}

// INACTIVE — not used in the active booking flow or active admin
model EventAddon {
  id          String             @id @default(cuid())
  venueId     String?
  packageId   String?
  name        String
  slug        String             @unique
  description String?
  price       Int
  category    EventAddonCategory @default(OTHER)
  image       String?
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)

  // Relations
  venue          Venue?          @relation(fields: [venueId], references: [id])
  eventPackage   EventPackage?   @relation(fields: [packageId], references: [id])
  // bookingAddons  BookingAddon[]  // TODO(Phase 2): Uncomment when BookingAddon is activated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, isActive, sortOrder])
  @@index([packageId, isActive, sortOrder])
}

model AgreementTemplate {
  id        String  @id @default(cuid())
  title     String
  content   String
  version   String
  isActive  Boolean @default(true)

  signedAgreements SignedAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([title, version])
  @@index([isActive, createdAt])
}


// =======================================================
// OCCASSIONS & INPUT FIELDS
// =======================================================

model Occasion {
  id        String  @id @default(cuid())
  key       String  @unique // BIRTHDAY, ANNIVERSARY, etc.
  label     String // Birthday
  icon      String // icon path or URL
  subtext   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  fields OccasionField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OccasionField {
  id         String @id @default(cuid())
  occasionId String

  fieldKey    String // name, partner1, partner2
  label       String // Input label
  placeholder String? //e.g. Arpan
  isRequired  Boolean @default(true)
  sortOrder   Int     @default(0)

  occasion Occasion @relation(fields: [occasionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================================================
// USER & BOOKING
// =======================================================

// User (Customer)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String   @unique
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  isGuest      Boolean  @default(true)

  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?

  bookings       Booking[]
  sessionVersion Int       @default(1)

  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
}

// Booking
// Core transaction entity.
model Booking {
  id         String @id @default(cuid())
  bookingRef String @unique // HRMMDDYYYYNNNNN, e.g. HR0607202600001

  userId       String? // optional
  contactName  String?
  contactPhone String?
  contactEmail String?

  venueId   String?
  packageId String?

  eventDate         DateTime? @db.Date
  eventStartTime    String?
  eventEndTime      String?
  eventType         String?
  specialInstructions String?

  occasionKey        String? // BIRTHDAY
  occasionLabel      String? // Birthday
  occasionData       Json? //Nstores dynamic occasion form data
  packageSnapshot    Json?
  pricingSnapshot    Json?
  startsAtUtc        DateTime? @db.Timestamptz(3)
  endsAtUtc          DateTime? @db.Timestamptz(3)
  occupiedUntilUtc   DateTime? @db.Timestamptz(3)
  bufferMinutes      Int? // booking-owned snapshot; required for new range bookings after backfill
  timezone           String?
  lockVersion        Int?
  holdExpiresAt      DateTime? @db.Timestamptz(3)
  guestCount         Int
  decorationRequired Boolean @default(false)

  baseAmount       Int
  extrasAmount     Int
  productsAmount   Int @default(0)
  discountAmount   Int
  totalAmount      Int
  decorationAmount Int @default(0)

  advancePaid      Int // ₹750
  remainingPayable Int

  paymentStatus PaymentStatus?
  bookingStatus BookingStatus

  // Provider-neutral payment fields used by future gateways.
  paymentProvider      String?
  paymentOrderId       String?
  paymentTransactionId String?
  paymentSignature     String?
  paymentCheckoutUrl   String?

  termsAcceptedAt DateTime?

  // Admin review workflow. Rejection is a review decision and is deliberately
  // kept separate from cancelledAt/cancelledReason, which stay operational.
  reviewSubmittedAt DateTime?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?
  approvalNotes     String?
  internalNotes     String?

  cancelledAt     DateTime?
  cancelledReason String?

  confirmationEmailSent  Boolean @default(false)
  abandonmentCustomerEmailSentAt DateTime?
  abandonmentAdminEmailSentAt    DateTime?
  recoveredFromBookingId String?
  createdByRole          String?
  createdByAdminId       String?

  couponUsages CouponUsage[]
  signedAgreements SignedAgreement[]
  // bookingAddons BookingAddon[] // TODO(Phase 2): Event addon line items — not yet in use

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?         @relation(fields: [userId], references: [id])
  venue        Venue?        @relation(fields: [venueId], references: [id])
  eventPackage EventPackage? @relation(fields: [packageId], references: [id])
  items        BookingItem[]
  payment      Payment[]

  @@index([createdAt])
  @@index([paymentStatus, createdAt])
  @@index([bookingStatus, createdAt])
  @@index([cancelledReason])
  @@index([paymentProvider, paymentOrderId])
  @@index([paymentProvider, paymentTransactionId])
  @@index([venueId, packageId, eventDate])
  @@index([venueId, bookingStatus, holdExpiresAt])
  @@index([venueId, startsAtUtc, occupiedUntilUtc])
  @@index([bookingStatus, reviewSubmittedAt])
  @@index([reviewedByAdminId, reviewedAt])
}

model BookingReferenceCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


// Values are appended, never reordered or removed: PostgreSQL enum values are
// positional and existing rows depend on them.
//
// Lifecycle: INCOMPLETE (draft) -> PENDING_REVIEW -> APPROVED | REJECTED,
// then APPROVED -> COMPLETED once the event has finished, with CANCELLED
// reachable from PENDING_REVIEW/APPROVED. Payment progress lives exclusively
// on PaymentStatus — the two axes are independent.
//
// Legacy (payment-first) values retained so historic rows stay readable:
// AWAITING_PAYMENT, PAYMENT_PROCESSING, PAID_EXPIRED. The public flow must
// not write these. (CONFIRMED was removed; its rows were migrated to
// APPROVED.)
enum BookingStatus {
  INCOMPLETE
  AWAITING_PAYMENT
  PAYMENT_PROCESSING
  CANCELLED
  ABANDONED
  PAID_EXPIRED
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  INITIALIZED // payment order created
  AWAITING_PAYMENT // checkout opened / user redirected
  PAID
  MANUAL_REVIEW // provider captured payment but booking could not be confirmed
  FAILED
  CANCELLED
  EXPIRED // user abandoned after init
  OFFLINE
}

// Booking Items (Extras Added)
// Snapshot pricing — NEVER recalc from product later
model BookingItem {
  id        String @id @default(cuid())
  bookingId String
  variantId String
  productId String

  variantLabel String // snapshot
  productName  String
  category     ProductCategory
  unitPrice    Int
  quantity     Int
  totalPrice   Int

  createdAt DateTime @default(now())

  booking Booking  @relation(fields: [bookingId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@unique([bookingId, variantId])
  @@index([bookingId])
  @@index([variantId])
}

