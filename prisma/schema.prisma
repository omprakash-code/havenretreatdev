model SignedAgreement {
  id                  String @id @default(cuid())
  agreementRef        String @unique
  bookingId           String
  agreementTemplateId String
  signerName          String
  signerEmail         String
  signedAt            DateTime
  signatureImage      String
  ipAddress           String?
  userAgent           String?
  agreementVersion    String?
  agreementHtmlSnapshot String?
  acknowledgedClauses Json?
  confirmationAccepted Boolean @default(false)
  paymentReference    String?
  pdfGeneratedAt      DateTime?
  pdfFileName         String?
  pdfSha256           String?
  pdfContent          Bytes?

  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agreementTemplate AgreementTemplate @relation(fields: [agreementTemplateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId, signedAt])
  @@index([agreementTemplateId])
}

// =======================================================
// LEGACY THEATRE PRODUCT / EXTRA MODULE
// TODO(Haven Phase 2): Gradually flatten Product/ProductVariant into EventAddon where appropriate.
// =======================================================

// Products (Cakes, Decor, Gifts)
// Unified product table (future filters by category & occasion)
model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  image       String
  description String?
  locationId  String?
  category    ProductCategory
  bookingCategorySlug        String?
  bookingCategoryLabel       String?
  bookingCategoryDescription String?
  bookingCategorySortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  location     Location?        @relation(fields: [locationId], references: [id])
  variants     ProductVariant[]
  bookingItems BookingItem[]
}

enum ProductCategory {
  CAKE
  DECORATION
  GIFT
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  label        String // "500g", "1kg", "Premium", "Gold"
  regularPrice Int
  salePrice    Int? // optional
  stock        Int? // null = unlimited (untracked), 0 = out of stock, N = tracked inventory
  maxPerBooking Int? // null = no per-booking cap, N = max quantity allowed in a single booking
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
}

// =======================================================
// PAYMENTS
// =======================================================

// Payment
// Square + Offline support
model Payment {
  id        String @id @default(cuid())
  bookingId String

  provider           String // "SQUARE" | "OFFLINE"
  transactionId      String?
  providerOrderId    String?
  providerPaymentId  String?
  bookingLockVersion Int?
  idempotencyKey     String?
  providerPayload    Json?
  method             String? // UPI, Card, Cash
  recordedByAdminId  String?

  amount Int
  status PaymentStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
  @@index([bookingId, bookingLockVersion, createdAt])
  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@unique([provider, idempotencyKey])
}

// =======================================================
// WAITLIST — INACTIVE: not used in the active booking flow or active admin
// =======================================================
model WaitlistEntry {
  id        String @id @default(cuid())
  reference String @unique

  name  String
  phone String
  email String?

  city               String?
  locationPreference String?
  theatrePreference  String?

  preferredDate DateTime? @db.Date
  preferredTime String?
  peopleCount   Int?

  occasion String?
  notes    String?

  status WaitlistStatus @default(NEW)

  contactedAt      DateTime?
  closedAt         DateTime?
  handledByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([locationPreference])
  @@index([createdAt])
}

enum WaitlistStatus {
  NEW
  CONTACTED
  CLOSED
}

// =======================================================
// CONTACT INQUIRIES — INACTIVE: not used in the active booking flow or active admin
// =======================================================
model ContactInquiry {
  id String @id @default(cuid())

  name    String
  mobile  String
  message String

  status      ContactInquiryStatus @default(NEW)
  isRead      Boolean              @default(false)
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([mobile])
  @@index([createdAt])
}

enum ContactInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// =======================================================
// COUPONS
// =======================================================
model Coupon {
  id   String @id @default(cuid())
  code String @unique

  discountType  CouponDiscountType
  discountValue Int // flat amount OR percentage
  maxDiscount   Int? // required when percentage

  isStackable Boolean @default(false)
  stackableCouponIds String[] @default([])

  validFrom DateTime  // activation time (IST-safe)
  validTill DateTime?

  scope CouponScope @default(BOOKING_TOTAL)

  usageLimit        Int? // null = unlimited
  perUserUsageLimit Int?
  minimumAmount     Int?

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  locationId String?

  createdBy  String
  modifiedBy String?
  modifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  location Location?     @relation(fields: [locationId], references: [id])
  rules    CouponRule[]
  usages   CouponUsage[]

  @@index([code])
  @@index([isActive, isDeleted])
}

enum CouponDiscountType {
  FLAT
  PERCENTAGE
}

enum CouponScope {
  BOOKING_TOTAL
  PRODUCTS_ONLY
  EXTRAS_ONLY
}

model CouponRule {
  id       String @id @default(cuid())
  couponId String

  type     CouponRuleType
  operator RuleOperator
  value    Json

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId, type])
}

enum CouponRuleType {
  BOOKING_DATE_RANGE
  BOOKING_TIME_RANGE
  BOOKING_DURATION_MIN
  CATEGORY // booking items category
  PRODUCT_ID
  USER_ID
  TARGET_CATEGORY // discount applies only to matching item categories
  TARGET_PRODUCT_ID // discount applies only to matching products
  DECORATION_REQUIRED // booking/contact step decoration preference
}

enum RuleOperator {
  IN
  NOT_IN
  BETWEEN
  EQUALS
}

model CouponUsage {
  id        String  @id @default(cuid())
  couponId  String
  bookingId String?
  userId    String?

  status CouponUsageStatus

  discountAmount Int?

  reservedAt  DateTime  @default(now())
  confirmedAt DateTime?
  releasedAt  DateTime?

  coupon  Coupon   @relation(fields: [couponId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@unique([couponId, bookingId])
  @@index([couponId])
  @@index([userId])
  @@index([bookingId])
  @@index([bookingId, status, reservedAt])
  @@index([couponId, userId, status])
}

enum CouponUsageStatus {
  RESERVED // booking in progress
  CONFIRMED // payment success
  RELEASED // abandoned / failed
}

// =======================================================
// CONFIG: System Setting
// =======================================================
model AppSetting {
  key   String @id
  value String
}
